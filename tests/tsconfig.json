{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "../.test-build",
    "rootDir": "..",
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "incremental": false,
    "tsBuildInfoFile": "../.test-build/tsconfig.tsbuildinfo"
  },
  "include": [
    "../lib/auth-cookie.ts",
    "../lib/auth-actions.ts",
    "../lib/require-auth.ts",
    "../app/dashboard/actions.ts",
    "../lib/matter-normalizers.ts",
    "../lib/matter-sync-progress.ts",
    "../lib/matter-sync.ts",
    "../lib/metrics-service.ts",
    "../lib/articles-service.ts",
    "../lib/reading-personality.ts",
    "../lib/supabase-queries.ts",
    "../lib/supabase-types.ts",
    "../lib/sync-run-log.ts",
    "../app/dashboard/page.tsx",
    "../app/settings/page.tsx",
    "../app/activity/page.tsx",
    "../app/articles/page.tsx",
    "../app/articles/[id]/page.tsx",
    "../app/authors/page.tsx",
    "../app/sources/page.tsx",
    "../app/tags/page.tsx",
    "../app/page.tsx",
    "../app/_components/app-navigation.tsx",
    "../app/reports/page.tsx",
    "../app/year-in-reading/page.tsx",
    "./**/*.test.ts"
  ]
}
